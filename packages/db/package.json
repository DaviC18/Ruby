{
	"name": "@ruby/db",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./schema": {
			"types": "./src/schema/index.ts",
			"default": "./src/schema/index.ts"
		}
	},
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"postgres": "^4.1.1"
	},
	"devDependencies": {
		"drizzle-kit": "^0.31.11",
		"pg": "^8.23.1",
		"vitest": "^5.1.0"
	}
}
